mooring @960,144 id=e043 target_room=ow_5_2 target_mooring=e043 landing_offset=0,56
water @48,480 size=96,192
mooring @144,480 id=e055 target_room=ow_4_3 target_mooring=e055 landing_offset=56,0
water @1872,480 size=96,192
